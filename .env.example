# App Config
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# Admin panel (/admin) — product management
# Long random string used to sign admin session cookies. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Bootstrap credentials for the first admin account. Only used the very first
# time the database is created (when the users table is empty). Once you've
# logged in, manage additional colleagues from /admin/users.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Optional overrides — defaults are set in the Docker image for production.
# Only needed for local development outside Docker.
# STORE_DB_PATH=.data/db/store.db
# STORE_UPLOADS_DIR=.data/uploads
